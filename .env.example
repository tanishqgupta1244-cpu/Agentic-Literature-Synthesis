# Application Environment
APP_ENV=development
DEBUG=true

# Backend
BACKEND_PORT=8000
BACKEND_URL=http://localhost:8000

# Frontend
FRONTEND_PORT=3000
FRONTEND_URL=http://localhost:3000

# Database
DATABASE_URL=postgresql://reviewer:password@localhost:5432/literature_review_dev
DB_HOST=localhost
DB_PORT=5432
DB_NAME=literature_review_dev
DB_USER=reviewer
DB_PASSWORD=your_secure_password_here

# Optional: pgvector
# Uncomment if pgvector is installed and you want to enable vector search
# PGVECTOR_ENABLED=false

# LangGraph (future phases)
# LANGGRAPH_ENABLED=false

# LLM Configuration (future phases)
# OPENAI_API_KEY=your_api_key_here
# LLM_MODEL=gpt-4
